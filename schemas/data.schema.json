{
  "$defs": {
    "FilesCfg": {
      "properties": {
        "sample_submission": {
          "default": "sample_submission.csv",
          "description": "Filename for sample submission CSV",
          "title": "Sample Submission",
          "type": "string"
        },
        "test_identity": {
          "default": "test_identity.csv",
          "description": "Filename for test identity CSV",
          "title": "Test Identity",
          "type": "string"
        },
        "test_transaction": {
          "default": "test_transaction.csv",
          "description": "Filename for test transaction CSV",
          "title": "Test Transaction",
          "type": "string"
        },
        "train_identity": {
          "default": "train_identity.csv",
          "description": "Filename for training identity CSV",
          "title": "Train Identity",
          "type": "string"
        },
        "train_transaction": {
          "default": "train_transaction.csv",
          "description": "Filename for training transaction CSV",
          "title": "Train Transaction",
          "type": "string"
        }
      },
      "title": "FilesCfg",
      "type": "object"
    },
    "ValidationCfg": {
      "properties": {
        "target_values": {
          "default": [
            0,
            1
          ],
          "description": "Expected unique values in target column",
          "examples": [
            [
              0,
              1
            ]
          ],
          "items": {
            "type": "integer"
          },
          "title": "Target Values",
          "type": "array"
        },
        "transaction_amt_positive": {
          "default": true,
          "description": "TransactionAmt must be positive",
          "title": "Transaction Amt Positive",
          "type": "boolean"
        },
        "transaction_id_unique": {
          "default": true,
          "description": "TransactionID must be unique",
          "examples": [
            true,
            false
          ],
          "title": "Transaction Id Unique",
          "type": "boolean"
        }
      },
      "title": "ValidationCfg",
      "type": "object"
    }
  },
  "properties": {
    "base_dir": {
      "default": "data",
      "description": "Root data directory",
      "title": "Base Dir",
      "type": "string"
    },
    "features_dir": {
      "default": "data/features",
      "description": "Feature Feather directory",
      "title": "Features Dir",
      "type": "string"
    },
    "files": {
      "$ref": "#/$defs/FilesCfg",
      "description": "Input/output filenames"
    },
    "join_key": {
      "default": "TransactionID",
      "description": "Column used to merge transaction and identity tables",
      "title": "Join Key",
      "type": "string"
    },
    "processed_dir": {
      "default": "data/processed",
      "description": "Processed Parquet directory",
      "title": "Processed Dir",
      "type": "string"
    },
    "raw_dir": {
      "default": "data/raw",
      "description": "Raw CSV directory",
      "title": "Raw Dir",
      "type": "string"
    },
    "target": {
      "default": "isFraud",
      "description": "Target column name",
      "title": "Target",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/ValidationCfg",
      "description": "Data quality validation rules"
    }
  },
  "required": [
    "files",
    "validation"
  ],
  "title": "DataConfig",
  "type": "object"
}
