{
  "$defs": {
    "AdversarialValCfg": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable adversarial validation (trains RF to detect train/val drift)",
          "title": "Enabled",
          "type": "boolean"
        },
        "seed": {
          "default": 42,
          "description": "Random seed for adversarial validation RF",
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "AdversarialValCfg",
      "type": "object"
    },
    "CostsCfg": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Optimize decision threshold on expected cost instead of F1",
          "title": "Enabled",
          "type": "boolean"
        },
        "false_positive_cost": {
          "default": 1.0,
          "description": "Cost of a false positive (manual review of a normal transaction)",
          "exclusiveMinimum": 0.0,
          "title": "False Positive Cost",
          "type": "number"
        },
        "false_negative_cost": {
          "default": 10.0,
          "description": "Cost of a false negative (fraud that is not blocked)",
          "exclusiveMinimum": 0.0,
          "title": "False Negative Cost",
          "type": "number"
        },
        "n_thresholds": {
          "default": 100,
          "description": "Threshold grid for cost search",
          "maximum": 1000,
          "minimum": 10,
          "title": "N Thresholds",
          "type": "integer"
        }
      },
      "title": "CostsCfg",
      "type": "object"
    },
    "DVCLiveCfg": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable DVCLive logging for DVC metrics/plots",
          "title": "Enabled",
          "type": "boolean"
        },
        "dir": {
          "default": "dvclive",
          "description": "DVCLive output directory",
          "title": "Dir",
          "type": "string"
        },
        "report": {
          "anyOf": [
            {
              "enum": [
                "md",
                "notebook",
                "html"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DVCLive report mode. 'notebook' only works inside a notebook and warns otherwise; keep None (or 'html') for CLI runs",
          "title": "Report"
        }
      },
      "title": "DVCLiveCfg",
      "type": "object"
    },
    "ErrorAnalysisCfg": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable error distribution analysis",
          "title": "Enabled",
          "type": "boolean"
        },
        "features": {
          "description": "Features to analyse for error distribution",
          "items": {
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "title": "ErrorAnalysisCfg",
      "type": "object"
    },
    "FBetaCfg": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Compute F-beta at the default threshold",
          "title": "Enabled",
          "type": "boolean"
        },
        "beta": {
          "default": 2.0,
          "description": "Beta > 1 weights recall more than precision (fraud-friendly)",
          "minimum": 0.0,
          "title": "Beta",
          "type": "number"
        }
      },
      "title": "FBetaCfg",
      "type": "object"
    },
    "LearningCurvesCfg": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable learning curves (re-trains model)",
          "title": "Enabled",
          "type": "boolean"
        },
        "train_sizes": {
          "description": "Training set size fractions",
          "items": {
            "type": "number"
          },
          "title": "Train Sizes",
          "type": "array"
        }
      },
      "title": "LearningCurvesCfg",
      "type": "object"
    },
    "ModelCardCfg": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Generate model card markdown",
          "title": "Enabled",
          "type": "boolean"
        },
        "filename": {
          "default": "model_card.md",
          "description": "Output filename for model card (in plot output dir)",
          "title": "Filename",
          "type": "string"
        }
      },
      "title": "ModelCardCfg",
      "type": "object"
    },
    "PlotCfg": {
      "properties": {
        "output_dir": {
          "default": "models/",
          "description": "Directory for plot images",
          "title": "Output Dir",
          "type": "string"
        },
        "plots": {
          "description": "Plots to generate",
          "items": {
            "enum": [
              "roc_curve",
              "pr_curve",
              "calibration",
              "error_analysis",
              "learning_curves",
              "feature_importance_stability",
              "adversarial_validation"
            ],
            "type": "string"
          },
          "title": "Plots",
          "type": "array"
        },
        "output_format": {
          "default": "webp",
          "description": "Image format for saved plots (webp for web embedding)",
          "enum": [
            "png",
            "webp"
          ],
          "title": "Output Format",
          "type": "string"
        },
        "dpi": {
          "default": 150,
          "description": "DPI for saved plot images",
          "maximum": 600,
          "minimum": 72,
          "title": "Dpi",
          "type": "integer"
        },
        "error_features": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Features for error analysis histograms (None = auto)",
          "title": "Error Features"
        }
      },
      "title": "PlotCfg",
      "type": "object"
    },
    "RecallAtKCfg": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Compute recall captured in the top-k% of highest scores",
          "title": "Enabled",
          "type": "boolean"
        },
        "fractions": {
          "description": "Fractions of the validation set to review (top-k)",
          "items": {
            "type": "number"
          },
          "title": "Fractions",
          "type": "array"
        }
      },
      "title": "RecallAtKCfg",
      "type": "object"
    },
    "ReportCfg": {
      "properties": {
        "path": {
          "default": "models/report.json",
          "description": "Path for JSON evaluation report",
          "title": "Path",
          "type": "string"
        }
      },
      "title": "ReportCfg",
      "type": "object"
    },
    "SegmentsCfg": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable per-segment analysis",
          "title": "Enabled",
          "type": "boolean"
        },
        "columns": {
          "description": "Columns for per-segment analysis",
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "min_samples": {
          "default": 50,
          "description": "Minimum samples per segment",
          "minimum": 10,
          "title": "Min Samples",
          "type": "integer"
        }
      },
      "title": "SegmentsCfg",
      "type": "object"
    },
    "StabilityCfg": {
      "properties": {
        "feature_importance": {
          "default": false,
          "description": "Enable feature importance stability analysis (re-trains model N times)",
          "title": "Feature Importance",
          "type": "boolean"
        },
        "n_iterations": {
          "default": 10,
          "description": "Number of re-fits for stability",
          "maximum": 100,
          "minimum": 3,
          "title": "N Iterations",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "description": "Random seed for stability refits",
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "StabilityCfg",
      "type": "object"
    },
    "ThresholdCfg": {
      "properties": {
        "threshold": {
          "default": 0.5,
          "description": "Default decision threshold",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "n_thresholds": {
          "default": 100,
          "description": "Number of thresholds for tuning",
          "maximum": 1000,
          "minimum": 10,
          "title": "N Thresholds",
          "type": "integer"
        },
        "bootstrap": {
          "default": true,
          "description": "Compute bootstrap confidence intervals",
          "title": "Bootstrap",
          "type": "boolean"
        },
        "bootstrap_metric": {
          "default": "average_precision",
          "description": "Metric for bootstrap CI",
          "enum": [
            "roc_auc",
            "average_precision"
          ],
          "title": "Bootstrap Metric",
          "type": "string"
        },
        "bootstrap_iterations": {
          "default": 1000,
          "description": "Bootstrap iterations",
          "maximum": 10000,
          "minimum": 50,
          "title": "Bootstrap Iterations",
          "type": "integer"
        },
        "bootstrap_seed": {
          "default": 42,
          "description": "Random seed for bootstrap resampling",
          "title": "Bootstrap Seed",
          "type": "integer"
        }
      },
      "title": "ThresholdCfg",
      "type": "object"
    }
  },
  "properties": {
    "threshold": {
      "$ref": "#/$defs/ThresholdCfg",
      "description": "Threshold tuning configuration"
    },
    "segments": {
      "$ref": "#/$defs/SegmentsCfg",
      "description": "Per-segment analysis configuration"
    },
    "learning_curves": {
      "$ref": "#/$defs/LearningCurvesCfg",
      "description": "Learning curves configuration"
    },
    "stability": {
      "$ref": "#/$defs/StabilityCfg",
      "description": "Feature importance stability configuration"
    },
    "error_analysis": {
      "$ref": "#/$defs/ErrorAnalysisCfg",
      "description": "Error analysis configuration"
    },
    "adversarial_validation": {
      "$ref": "#/$defs/AdversarialValCfg",
      "description": "Adversarial validation configuration"
    },
    "model_card": {
      "$ref": "#/$defs/ModelCardCfg",
      "description": "Model card configuration"
    },
    "dvclive": {
      "$ref": "#/$defs/DVCLiveCfg",
      "description": "DVCLive logging configuration"
    },
    "plots": {
      "$ref": "#/$defs/PlotCfg",
      "description": "Plot configuration"
    },
    "report": {
      "$ref": "#/$defs/ReportCfg",
      "description": "Report output configuration"
    },
    "costs": {
      "$ref": "#/$defs/CostsCfg",
      "description": "Expected-cost threshold optimization"
    },
    "f_beta": {
      "$ref": "#/$defs/FBetaCfg",
      "description": "F-beta (fraud-friendly) metric"
    },
    "recall_at_k": {
      "$ref": "#/$defs/RecallAtKCfg",
      "description": "Recall captured in the top-k% of highest scores"
    },
    "brier": {
      "default": true,
      "description": "Compute Brier score (probability calibration)",
      "title": "Brier",
      "type": "boolean"
    }
  },
  "title": "EvaluateConfig",
  "type": "object"
}
